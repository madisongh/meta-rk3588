From e1f7512e30cfa8bf6568873463b253538389c08b Mon Sep 17 00:00:00 2001
From: Yu Qiaowei <cerf.yu@rock-chips.com>
Date: Tue, 10 Mar 2026 13:56:28 -0700
Subject: [PATCH 2/2] normal: remove multi-task mode

Upstream-Status: Backport
Signed-off-by: Yu Qiaowei <cerf.yu@rock-chips.com>
Change-Id: Iec98e5c35a212ed5c8afa28d20f7995a118d14d5
(cherry picked from commit 4d6b03cc79ad681cf1aeafa22df1c120f0304e8c)
Signed-off-by: Matt Madison <matt@madison.systems>
---
 core/NormalRga.cpp | 134 +++++++++++++++------------------------------
 1 file changed, 44 insertions(+), 90 deletions(-)

diff --git a/core/NormalRga.cpp b/core/NormalRga.cpp
index 80a30e3..19ba562 100644
--- a/core/NormalRga.cpp
+++ b/core/NormalRga.cpp
@@ -35,7 +35,6 @@ pthread_mutex_t mMutex = PTHREAD_MUTEX_INITIALIZER;
 
 volatile int32_t refCount = 0;
 struct rgaContext *rgaCtx = NULL;
-extern struct im2d_job_manager g_im2d_job_manager;
 
 void is_debug_log(void) {
     struct rgaContext *ctx = rgaCtx;
@@ -400,6 +399,7 @@ int RgaBlit(rga_info *src, rga_info *dst, rga_info *src1) {
     void *src1Buf = NULL;
     RECT clip;
     int sync_mode = RGA_BLIT_SYNC;
+    void *ioc_req = NULL;
 
     //init context
     if (!ctx) {
@@ -1457,55 +1457,32 @@ int RgaBlit(rga_info *src, rga_info *dst, rga_info *src1) {
     rgaReg.core = dst->core;
     rgaReg.priority = dst->priority;
 
-    if (dst->job_handle > 0) {
-        im_rga_job_t *job = NULL;
-
-        g_im2d_job_manager.mutex.lock();
-
-        job = g_im2d_job_manager.job_map[dst->job_handle];
-        if (job->task_count >= RGA_TASK_NUM_MAX) {
-            printf("job[%d] add task failed! too many tasks, count = %d\n", dst->job_handle, job->task_count);
-
-            g_im2d_job_manager.mutex.unlock();
-            return -errno;
-        }
-
-        job->req[job->task_count] = rgaReg;
-        job->task_count++;
-
-        g_im2d_job_manager.mutex.unlock();
-
-        return 0;
-    } else {
-        void *ioc_req = NULL;
-
-        switch (ctx->driver) {
-            case RGA_DRIVER_IOC_RGA2:
-                rga2_req compat_req;
-
-                memset(&compat_req, 0x0, sizeof(compat_req));
-                NormalRgaCompatModeConvertRga2(&compat_req, &rgaReg);
+    switch (ctx->driver) {
+        case RGA_DRIVER_IOC_RGA2:
+            rga2_req compat_req;
 
-                ioc_req = &compat_req;
-                break;
+            memset(&compat_req, 0x0, sizeof(compat_req));
+            NormalRgaCompatModeConvertRga2(&compat_req, &rgaReg);
 
-            case RGA_DRIVER_IOC_MULTI_RGA:
-                ioc_req = &rgaReg;
-                break;
+            ioc_req = &compat_req;
+            break;
 
-            default:
-                printf("unknow driver[0x%x]\n", ctx->driver);
-                return -errno;
-        }
+        case RGA_DRIVER_IOC_MULTI_RGA:
+            ioc_req = &rgaReg;
+            break;
 
-        do {
-            ret = ioctl(ctx->rgaFd, sync_mode, ioc_req);
-        } while (ret == -1 && (errno == EINTR || errno == 512));   /* ERESTARTSYS is 512. */
-        if(ret) {
-            printf(" %s(%d) RGA_BLIT fail: %s\n",__FUNCTION__, __LINE__,strerror(errno));
-            ALOGE(" %s(%d) RGA_BLIT fail: %s",__FUNCTION__, __LINE__,strerror(errno));
+        default:
+            printf("unknow driver[0x%x]\n", ctx->driver);
             return -errno;
-        }
+    }
+
+    do {
+        ret = ioctl(ctx->rgaFd, sync_mode, ioc_req);
+    } while (ret == -1 && (errno == EINTR || errno == 512));   /* ERESTARTSYS is 512. */
+    if(ret) {
+        printf(" %s(%d) RGA_BLIT fail: %s\n",__FUNCTION__, __LINE__,strerror(errno));
+        ALOGE(" %s(%d) RGA_BLIT fail: %s",__FUNCTION__, __LINE__,strerror(errno));
+        return -errno;
     }
 
     if (ctx->driver == RGA_DRIVER_IOC_MULTI_RGA)
@@ -1553,6 +1530,7 @@ int RgaCollorFill(rga_info *dst) {
     COLOR_FILL fillColor ;
     void *dstBuf = NULL;
     RECT clip;
+    void *ioc_req = NULL;
 
     int sync_mode = RGA_BLIT_SYNC;
 
@@ -1766,56 +1744,32 @@ int RgaCollorFill(rga_info *dst) {
     rgaReg.core = dst->core;
     rgaReg.priority = dst->priority;
 
-    if (dst->job_handle > 0)
-    {
-        im_rga_job_t *job = NULL;
-
-        g_im2d_job_manager.mutex.lock();
-
-        job = g_im2d_job_manager.job_map[dst->job_handle];
-        if (job->task_count >= RGA_TASK_NUM_MAX) {
-            printf("job[%d] add task failed! too many tasks, count = %d\n", dst->job_handle, job->task_count);
-
-            g_im2d_job_manager.mutex.unlock();
-            return -errno;
-        }
-
-        job->req[job->task_count] = rgaReg;
-        job->task_count++;
-
-        g_im2d_job_manager.mutex.unlock();
-
-        return 0;
-    } else {
-        void *ioc_req = NULL;
-
-        switch (ctx->driver) {
-            case RGA_DRIVER_IOC_RGA2:
-                rga2_req compat_req;
-
-                memset(&compat_req, 0x0, sizeof(compat_req));
-                NormalRgaCompatModeConvertRga2(&compat_req, &rgaReg);
+    switch (ctx->driver) {
+        case RGA_DRIVER_IOC_RGA2:
+            rga2_req compat_req;
 
-                ioc_req = &compat_req;
-                break;
+            memset(&compat_req, 0x0, sizeof(compat_req));
+            NormalRgaCompatModeConvertRga2(&compat_req, &rgaReg);
 
-            case RGA_DRIVER_IOC_MULTI_RGA:
-                ioc_req = &rgaReg;
-                break;
+            ioc_req = &compat_req;
+            break;
 
-            default:
-                printf("unknow driver[0x%x]\n", ctx->driver);
-                return -errno;
-        }
+        case RGA_DRIVER_IOC_MULTI_RGA:
+            ioc_req = &rgaReg;
+            break;
 
-        do {
-            ret = ioctl(ctx->rgaFd, sync_mode, ioc_req);
-        } while (ret == -1 && (errno == EINTR || errno == 512));   /* ERESTARTSYS is 512. */
-        if(ret) {
-            printf(" %s(%d) RGA_COLORFILL fail: %s\n",__FUNCTION__, __LINE__,strerror(errno));
-            ALOGE(" %s(%d) RGA_COLORFILL fail: %s",__FUNCTION__, __LINE__,strerror(errno));
+        default:
+            printf("unknow driver[0x%x]\n", ctx->driver);
             return -errno;
-        }
+    }
+
+    do {
+        ret = ioctl(ctx->rgaFd, sync_mode, ioc_req);
+    } while (ret == -1 && (errno == EINTR || errno == 512));   /* ERESTARTSYS is 512. */
+    if(ret) {
+        printf(" %s(%d) RGA_COLORFILL fail: %s\n",__FUNCTION__, __LINE__,strerror(errno));
+        ALOGE(" %s(%d) RGA_COLORFILL fail: %s",__FUNCTION__, __LINE__,strerror(errno));
+        return -errno;
     }
 
     dst->out_fence_fd = rgaReg.out_fence_fd;
-- 
